<Project Sdk="Aspire.AppHost.Sdk/13.6.5">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <UserSecretsId>1c57ae51-6d31-43f2-bc4b-df1f00541abc</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" Version="13.6.5" />
    <PackageReference Include="Aspire.Hosting.Azure.Functions" Version="13.6.5" />
    <PackageReference Include="Aspire.Hosting.Azure.ServiceBus" Version="13.6.5" />
    <PackageReference Include="Aspire.Hosting.Azure.Storage" Version="13.6.5" />
    <PackageReference Include="Aspire.Hosting.JavaScript" Version="13.6.5" />
    <PackageReference Include="Aspire.Hosting.Redis" Version="13.6.5" />
    <PackageReference Include="Aspire.Hosting.SqlServer" Version="13.6.5" />
    <!-- Aspire 13.6.x pulls in a Pkcs version with known advisories; the CI vulnerability gate fails on those. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Store.Api\Store.Api.csproj" />
    <ProjectReference Include="..\Store.Functions\Store.Functions.csproj" />
  </ItemGroup>

</Project>
