# Rendered with envsubst at container start (only ${API_BASE_URL} is substituted; nginx's own $variables are untouched).
server {
    listen 8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Everything is served from this origin; the only other place the page may talk to is the API.
    # NOTE: a location that calls add_header discards these, so locations below only use `expires`.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' ${API_BASE_URL}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;

    # Liveness probe for App Service health checks.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    # Runtime configuration and the HTML shell must always be revalidated; they change between deployments.
    location = /env.js {
        expires -1;
    }
    location = /index.html {
        expires -1;
    }

    # Build output is content-hashed, so it can be cached for a year. A missing file is a real 404, not the app shell.
    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    # Single-page app: unknown paths are client-side routes.
    location / {
        expires -1;
        try_files $uri $uri/ /index.html;
    }
}
